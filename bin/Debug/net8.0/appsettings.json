{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Edgegap": {
    "BaseUrl": "https://api.edgegap.com/v1/",
    "Token": "",
    "TimeoutSeconds": 15,
    "RetryAttempts": 3,
    "RetryBaseDelayMs": 500
  },
  "S3": {
    "EndPoint": "s3.timeweb.cloud",
    "BucketName": "",
    "AccessKey": "",
    "SecretKey": "",
    "CurrentWipeSavesPath": "sp/server-backups/current-wipe/",
    "ServersListSavesPath": "sp/servers-list/",
    "CredentialDeliveryMode": "PresignedUrls",
    "PresignedUrlExpirationMinutes": 15
  },
  "Security": {
    "RequireApiKeys": true,
    "ServerApiKey": "",
    "AdminApiKey": "",
    "ServerApiKeyHeaderName": "X-Server-Api-Key",
    "AdminApiKeyHeaderName": "X-Admin-Api-Key"
  },
  "GameClient": {
    "CurrentVersion": "0.0.1"
  },
  "Wipe": {
    "DayOfWeek": "Monday",
    "Time": "10:50",
    "TimeZone": "Europe/Moscow"
  },
  "ServerRegistry": {
    "StorageMode": "S3",
    "LocalPath": "Data/server-registry.json",
    "LocalCachePath": "Data/ServersListSaves",
    "StaleServerStateSeconds": 90
  }
}
